{
    "name": "yasinkuyu/omnipay-nestpay",
    "type": "library",
    "description": "NestPay / EST (Payten, Asseco) virtual POS gateway for Omnipay: 3D Pay Hosting, 3D Pay, 3D, refund, void, status (İş Bankası, Akbank, Halkbank, Ziraat, TEB, QNB, ING, Şekerbank, Anadolubank)",
    "keywords": ["nestpay", "est", "payten", "asseco", "sanal pos", "3d secure", "isbank", "akbank", "halkbank", "ziraat", "teb", "omnipay", "gateway", "payment"],
    "homepage": "https://github.com/yasinkuyu/omnipay-nestpay",
    "license": "MIT",
    "authors": [
        {"name": "Yasin Kuyu", "email": "yasinkuyu@gmail.com"},
        {"name": "Contributors", "homepage": "https://github.com/yasinkuyu/omnipay-nestpay/contributors"}
    ],
    "autoload": {"psr-4": {"Omnipay\\NestPay\\": "src/"}},
    "autoload-dev": {"psr-4": {"Omnipay\\NestPay\\Tests\\": "tests/"}},
    "require": {
        "php": "^8.1",
        "ext-simplexml": "*",
        "omnipay/common": "^3.3"
    },
    "require-dev": {
        "omnipay/tests": "^4.1",
        "php-http/guzzle7-adapter": "^1.0",
        "phpunit/phpunit": "^9.6"
    },
    "extra": {"branch-alias": {"dev-3.x": "3.x-dev"}},
    "config": {"allow-plugins": {"php-http/discovery": true}},
    "minimum-stability": "dev",
    "prefer-stable": true
}
